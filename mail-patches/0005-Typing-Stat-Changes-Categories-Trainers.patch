+	jr nc, .next1
+	cp 2
+    ld b, 26 ; Bit below Raichu's level
+	jr nc, .next1
+	cp 1
+	ld b, 22 ; Starmie's level
+	jr nc, .next1
+	ld b, 15 ; Onix's level
