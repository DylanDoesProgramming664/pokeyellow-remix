+    ld [wLevelCap], a
diff --git a/engine/battle/print_category.asm b/engine/battle/print_category.asm
new file mode 100644
index 0000000..00009e0
--- /dev/null
+++ b/engine/battle/print_category.asm
@@ -0,0 +1,32 @@
+PrintMoveCategory:
+; Copy the category name of move b to wStringBuffer.
+
+	ld a, b
+	dec a
+	ld bc, MOVE_LENGTH
+	ld hl, wPlayerMoveType
+	call AddNTimes
+	ld a, BANK(Moves)
+	call GetFarByte
+
+; Mask out the type
+	and ~TYPE_MASK
+; Shift the category bits into the range 0-3
+	rlc a
+	rlc a
+	rlc a
+	dec a
+
+	ld hl, CategoryNames
+	ld e, a
+	ld d, 0
+	add hl, de
+	add hl, de
+	ld a, [hli]
+	ld h, [hl]
+	ld l, a
+	ld de, wStringBuffer
+	ld bc, NAME_LENGTH
+	jp CopyData
+
+INCLUDE "data/types/category_names.asm"
