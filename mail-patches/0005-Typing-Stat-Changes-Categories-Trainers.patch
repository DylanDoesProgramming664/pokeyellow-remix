+	jr nc, .next1
+	cp 6
+	ld b, 53 ; Magmar's level
+	jr nc, .next1
+	cp 5
+	ld b, 50 ; Alakazam's level
+	jr nc, .next1
+    cp 4
+	ld b, 43 ; Venomoth's level
+	jr nc, .next1
+	cp 3
